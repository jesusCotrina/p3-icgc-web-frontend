# ─────────────────────────────────────────────────────────────────────────────
# Variables de la web pública. Copia este archivo como .env.local para local.
# En Vercel se cargan en: Settings → Environment Variables (y luego Redeploy).
# ─────────────────────────────────────────────────────────────────────────────

# URL pública del sitio (canónicas, sitemap, Open Graph).
#   Local:  http://localhost:3000
#   Vercel: https://tu-dominio.com  (si la dejas vacía, se usa el dominio del proyecto en Vercel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# URL pública del backend (imágenes, formulario de contacto, visitas).
#   Local:  http://localhost:4000
#   Vercel: OBLIGATORIA y con https, p. ej. https://api.tu-dominio.com
#           El backend no corre en Vercel: tiene que estar publicado en otro servidor.
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del backend para el render en servidor. Opcional.
#   Docker: http://backend:4000   ·   Local y Vercel: déjala vacía (usa NEXT_PUBLIC_API_URL)
API_INTERNAL_URL=

# Debe ser el mismo valor que REVALIDATE_SECRET del backend
REVALIDATE_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
