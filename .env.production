# Valores públicos para el build de producción (Vercel los lee al hacer `next build`).
# No pongas secretos aquí: este archivo se sube a git. REVALIDATE_SECRET va en
# Vercel → Settings → Environment Variables.
# En local, `npm run dev` sigue usando .env.local (backend en localhost).

NEXT_PUBLIC_API_URL=https://api.prometeoperu.com
# Vacía: en Vercel se usa el dominio de producción del proyecto.
# Cuando tengas el dominio final de la web, ponlo aquí (https://...).
NEXT_PUBLIC_SITE_URL=
